{
  "manifest_version": 3,
  "name": "Tag Inspector (GTM + Adobe Launch)",
  "version": "3.2.0",
  "description": "Competitive ad-ops intel: tags, conversions, ad accounts, media mix, data layers, server-side tracking and a funnel recorder.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect tags on this page"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["recorder-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["recorder-relay.js"],
      "run_at": "document_start"
    }
  ]
}
